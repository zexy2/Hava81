# Only the API process reads this secret. Never prefix it with VITE_.
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# Fastify API
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Browser-facing BFF address. Relative /api/v1 uses the Vite development proxy or Nginx in production.
VITE_API_BASE_URL=/api/v1
