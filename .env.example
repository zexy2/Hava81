# Copy to .env at the repository root. The API reads ./.env and ../../.env
# (apps/api/src/server.ts), Vite reads VITE_* variables at build time.
# Only the API process reads provider secrets. Never prefix them with VITE_.

# --- Fastify API (apps/api/src/config/env.ts) ---------------------------------
# Required.
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

PORT=4000
# Comma-separated browser origins allowed by CORS. The Vite dev server proxies
# /api to the API, so this only matters when the web app calls the API directly.
CORS_ORIGINS=http://localhost:3000

# Optional (defaults shown).
# HOST=0.0.0.0
# LOG_LEVEL=info
# Per-client requests per minute.
# RATE_LIMIT_MAX=60
# Process-wide cache-miss upstream calls per minute (503 UPSTREAM_BUDGET_EXHAUSTED above it).
# UPSTREAM_MAX_PER_MINUTE=300
# CACHE_MAX_ENTRIES=500
# CACHE_CURRENT_TTL_MS=300000
# CACHE_FORECAST_TTL_MS=1800000
# CACHE_AIR_QUALITY_TTL_MS=900000
# 81-province map layer (one Open-Meteo call counted as 81).
# CACHE_PROVINCES_TTL_MS=1800000
# PROVIDER_RETRY_COUNT=1
# PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
# PROVIDER_CIRCUIT_RESET_MS=30000
# OPENWEATHER_TIMEOUT_MS=8000
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# OPENWEATHER_FALLBACK_API_KEY=
# OPENWEATHER_FALLBACK_BASE_URL=
# OPEN_METEO_API_KEY=
# OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com
# OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com
# OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com
# Set by the Docker build (build-arg) in CI; reported by /api/v1/health. Local runs report "unknown".
# HAVA81_API_REVISION=

# --- Web app (src/config/env.config.ts) ---------------------------------------
# Browser-facing BFF address. Relative /api/v1 uses the Vite dev proxy (vite.config.ts)
# or Nginx in Docker. The production Pages build uses https://api.hava81.zekiakgul.dev/api/v1
# (GitHub Actions variable API_BASE_URL).
VITE_API_BASE_URL=/api/v1
# Optional (defaults shown).
# VITE_CACHE_TTL=300000
# VITE_MAX_RETRIES=3
