{
  "name": "weather-dashboard",
  "version": "2.0.0",
  "private": true,
  "homepage": "https://zexy2.github.io/Weather-app-for-Turkish-cities",
  "proxy": "https://api.openweathermap.org",
  "description": "Modern, production-ready weather dashboard with TypeScript, advanced caching, and comprehensive testing",
  "keywords": ["weather", "react", "typescript", "openweather", "dashboard"],
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "msw": "^2.1.0",
    "typescript": "^5.3.3",
    "gh-pages": "^6.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ci": "CI=true react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "docker:build": "docker build -t weather-dashboard .",
    "docker:run": "docker run -p 3000:80 weather-dashboard",
    "docker:dev": "docker-compose --profile dev up"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"],
    "rules": {
      "no-console": ["warn", { "allow": ["warn", "error", "debug"] }],
      "prefer-const": "error"
    }
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 20,
        "functions": 20,
        "lines": 20,
        "statements": 20
      }
    }
  }
}
