{
  "name": "hava81-weather-atlas",
  "version": "2.1.0",
  "private": true,
  "description": "Hava81: a decision-first meteorological atlas for all 81 Turkish provinces",
  "keywords": [
    "weather",
    "turkey",
    "meteorological-atlas",
    "react",
    "typescript",
    "openweather",
    "weather-forecast"
  ],
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@types/leaflet": "^1.9.21",
    "i18next": "^25.8.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "gh-pages": "^6.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^16.2.7",
    "msw": "^2.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/generate-city-pages.mjs && node scripts/apply-csp.mjs && node scripts/stamp-service-worker.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:test": "npm --prefix apps/api test",
    "api:type-check": "npm --prefix apps/api run type-check",
    "lint": "eslint src public/sw.js vite.config.ts playwright.config.ts \"e2e/**/*.ts\" scripts/audit-live-responsive.mjs scripts/capture-visual-audit.mjs scripts/verify-public-seo.mjs scripts/test-verify-public-seo.mjs scripts/lib/activate-deferred-forecast.mjs scripts/lib/live-audit-result.mjs scripts/lib/live-audit-response-cache.mjs scripts/lib/live-audit-target-selector.mjs scripts/lib/loopback-cdp-url.mjs scripts/lib/playwright-preview-port.mjs scripts/test-live-audit-options.mjs scripts/test-live-audit-result.mjs scripts/test-live-audit-response-cache.mjs && npm run lint:css",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:fix": "eslint . --fix",
    "analyze": "ANALYZE=true npm run build && npx --yes source-map-explorer@2.5.3 --no-border-checks --gzip --tsv dist/bundle-analysis.tsv $(find dist/assets -maxdepth 1 -type f -name '*.js' ! -name 'rolldown-runtime-*.js' -print)",
    "docker:build": "docker compose build",
    "docker:run": "docker compose up",
    "docker:dev": "docker compose --profile dev up weather-api weather-app-dev",
    "prepare": "husky",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test:watch": "vitest",
    "e2e": "node scripts/run-playwright.mjs",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "audit:live-ui": "node scripts/audit-live-responsive.mjs",
    "verify:81": "node scripts/verify-81-cities.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
